# ============================================================
# COSMOS-5H1 - Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit real secrets to version control.
# All variables are optional - the app degrades gracefully
# when a key is absent.
# ============================================================

# -- AI (PRIMARY): IBM Granite 3.3 via IBM watsonx.ai ─────────
# Free tier at https://dataplatform.cloud.ibm.com/
# 1. Create a project, copy the Project ID
# 2. Generate an IBM Cloud API key at https://cloud.ibm.com/iam/apikeys
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
# Model override. Defaults to ibm/granite-3-3-8b-instruct
WATSONX_MODEL=
# Region override. Defaults to us-south
WATSONX_REGION=

# -- AI (SECONDARY): Groq cloud (fast LLM inference) ──────────
# Free key at https://console.groq.com
# Used when WATSONX keys are absent.
GROQ_API_KEY=

# Groq model override. Defaults to llama-3.3-70b-versatile
GROQ_MODEL=

# -- AI (TERTIARY): OpenAI GPT-4o-mini ────────────────────────
# Used only when both WATSONX and GROQ keys are absent.
OPENAI_API_KEY=

# OpenAI model override. Defaults to gpt-4o-mini.
OPENAI_MODEL=

# -- Voice TTS ------------------------------------------------
# Murf AI API key. Missing => browser speechSynthesis fallback.
MURF_API_KEY=

# -- Voice STT ------------------------------------------------
# Deepgram API key. Missing => browser Web Speech API fallback.
DEEPGRAM_API_KEY=

# -- LiveKit --------------------------------------------------
# LiveKit credentials for real-time voice rooms.
# Missing => existing non-LiveKit voice implementation is used.
# LIVEKIT_API_SECRET must NEVER be exposed to the client.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=


# -- Google (Gemini LLM for LiveKit voice agent) ---------------------
# Required by backend/agent.py. Missing => agent won't start.
GOOGLE_API_KEY=

# -- NASA -----------------------------------------------------
# NASA API key. Missing => DEMO_KEY (rate-limited but functional).
NASA_API_KEY=

# -- Backend --------------------------------------------------
# Python backend URL (IBM Granite via Ollama). Public - safe for client.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000


