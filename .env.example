# ============================================================
# COSMOS-5H1 - Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit real secrets to version control.
# All variables are optional - the app degrades gracefully
# when a key is absent.
# ============================================================

# -- AI (PRIMARY): IBM Granite 3.3 via Groq cloud ─────────────
# Free key at https://console.groq.com
# When set, all AI routes use IBM Granite 3.3 8B Instruct.
GROQ_API_KEY=

# Granite model override. Defaults to ibm-granite/granite-3.3-8b-instruct.
GROQ_MODEL=

# -- AI (SECONDARY): OpenAI GPT-4o-mini ───────────────────────
# Used only when GROQ_API_KEY is absent.
OPENAI_API_KEY=

# OpenAI model override. Defaults to gpt-4o-mini.
OPENAI_MODEL=

# -- Voice TTS ------------------------------------------------
# Murf AI API key. Missing => browser speechSynthesis fallback.
MURF_API_KEY=

# -- Voice STT ------------------------------------------------
# Deepgram API key. Missing => browser Web Speech API fallback.
DEEPGRAM_API_KEY=

# -- LiveKit --------------------------------------------------
# LiveKit credentials for real-time voice rooms.
# Missing => existing non-LiveKit voice implementation is used.
# LIVEKIT_API_SECRET must NEVER be exposed to the client.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=


# -- Google (Gemini LLM for LiveKit voice agent) ---------------------
# Required by backend/agent.py. Missing => agent won't start.
GOOGLE_API_KEY=

# -- NASA -----------------------------------------------------
# NASA API key. Missing => DEMO_KEY (rate-limited but functional).
NASA_API_KEY=

# -- Backend --------------------------------------------------
# Python backend URL (IBM Granite via Ollama). Public - safe for client.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000


