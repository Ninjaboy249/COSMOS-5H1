# ============================================================
# COSMOS-5H1 - Environment Variables
# Copy this file to .env.local and fill in your values.
# No API keys required for core functionality.
# IBM Granite runs 100% locally via Ollama — zero cloud calls.
# ============================================================

# ── IBM Granite local backend ─────────────────────────────────
# URL of the local Python backend (backend/main.py).
# Default is http://localhost:8000. Only change if you run the
# backend on a different port.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# ── NASA API (optional) ───────────────────────────────────────
# Without this key the app uses DEMO_KEY (rate-limited but works).
# Get a free key at https://api.nasa.gov/
NASA_API_KEY=

# ── LiveKit real-time voice (optional) ────────────────────────
# Only needed for the live voice agent (backend/agent.py).
# The core app works fully without these.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Murf TTS (optional) ───────────────────────────────────────
# High-quality text-to-speech. Falls back to browser Speech API.
MURF_API_KEY=

# ── Deepgram STT (optional) ───────────────────────────────────
# High-quality speech-to-text. Falls back to browser Web Speech API.
DEEPGRAM_API_KEY=

# ── Google Gemini (optional, voice agent only) ────────────────
# Required only by backend/agent.py for the LiveKit voice agent.
GOOGLE_API_KEY=
